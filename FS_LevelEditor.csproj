    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>Library</OutputType>
    <RootNamespace>FS_LevelEditor</RootNamespace>
    <AssemblyName>FS_LevelEditor</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <TargetFrameworkIdentifier>.NETFramework</TargetFrameworkIdentifier>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <!-- Compile against UNITY's mscorlib (referenced below), NOT .NET Framework's -->
    <NoStdLib>true</NoStdLib>
    <GameManaged Condition=" '$(GameManaged)' == '' ">..\Fractal_Space_Data\Managed</GameManaged>
    <GameScripts Condition=" '$(GameScripts)' == '' ">$(GameManaged)</GameScripts>
    <GameRoot>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(GameManaged)', '..', '..'))))</GameRoot>
    <GameExe>$(GameRoot)\Fractal_Space.exe</GameExe>
    <StartAction>Program</StartAction>
    <StartProgram>$(GameExe)</StartProgram>
    <StartWorkingDirectory>$(GameRoot)</StartWorkingDirectory>
    <OutputPath Condition=" '$(OutputPath)' == '' ">$(USERPROFILE)\AppData\LocalLow\Haze Games\Fractal Space MOD\Mods\</OutputPath>
    <!-- OutputPath above is absolute and typically on a different drive (C:) than this
         project (e.g. G:). MSBuild's default OutDir derivation tries to make OutDir
         relative to the project directory and can truncate the drive letter when the
         drives differ, producing a broken root-relative path like "\Mods". Force OutDir
         to exactly match OutputPath so nothing re-derives it incorrectly. -->
    <OutDir>$(OutputPath)</OutDir>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ProjectGuid>{340F163F-4D3C-BA8B-B363-93CF1A0450F3}</ProjectGuid>
    <NuGetPackageImportStamp>
    </NuGetPackageImportStamp>
  </PropertyGroup>
  <!-- Global setting to prevent ANY copy-local behavior project-wide.
       NOTE: the NuGet package references below explicitly override this back to
       Private=True so Costura.Fody will pick them up and embed them into the output DLL. -->
  <ItemDefinitionGroup>
    <Reference>
      <Private>False</Private>
    </Reference>
  </ItemDefinitionGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Remove="Il2Cpp\**" />
    <None Remove="Il2Cpp\**" />
